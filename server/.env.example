# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=3500
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/cognifetch
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/cognifetch
MONGODB_URI=mongodb://127.0.0.1:27017/cognifetch

# ── Auth ────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# lax (default) works when the client and API share a site. Use "none" only for cross-site deployments.
COOKIE_SAMESITE=lax
# COOKIE_SECURE defaults to true in production.
# COOKIE_SECURE=true

# ── HTTP ────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API (not needed when SERVE_CLIENT=true).
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind one reverse proxy / load balancer (Render, Railway, Nginx...).
TRUST_PROXY=0
# Serve the built React app from this server (single-origin deployment).
SERVE_CLIENT=false

# ── Third-party APIs ────────────────────────────────────
# https://ocr.space/ocrapi  (free tier: 1 MB images, 25k requests/month)
OCR_API_KEY=
# https://aistudio.google.com/app/apikey  (optional — a heuristic is used when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

MAX_UPLOAD_MB=1
HTTP_TIMEOUT_MS=20000
